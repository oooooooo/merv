  },
  "license": "MIT",
  "keywords": [
    "mermaid",
    "vivliostyle",
    "markdown",
    "pdf",
    "cli"
  ],
  "allowScripts": {
    "puppeteer@25.4.0": true,
    "fsevents@2.3.3": true
  }
