{
  "name": "@noooooooode/merv",
  "version": "0.1.0",
  "description": "Markdown to PDF, using Mermaid.js and Vivliostyle CLI.",
  "type": "module",
  "bin": {
    "merv": "merv.js"
  },
  "files": [
    "merv.js",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "prepublishOnly": "npm test",
    "install:bin": "dir=$(mktemp -d) && git clone -q . \"$dir\" && (cd \"$dir\" && npx -y npm@11 pack -q >/dev/null && npx -y npm@11 install -g --prefix \"$HOME\" ./*.tgz); rc=$?; rm -rf \"$dir\"; exit $rc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oooooooo/merv.git"
  },
  "bugs": {
    "url": "https://github.com/oooooooo/merv/issues"
  },
  "homepage": "https://github.com/oooooooo/merv#readme",
  "publishConfig": {
    "access": "public"
  },
  "author": "oooooooo",
  "dependencies": {
    "@mermaid-js/mermaid-cli": "12.2.0",
    "@vivliostyle/cli": "11.4.0",
    "@vivliostyle/vfm": "2.7.2"
  },
  "license": "MIT",
  "keywords": [
    "mermaid",
    "vivliostyle",
    "markdown",
    "pdf",
    "cli"
  ],
  "allowScripts": {
    "puppeteer@25.16.0": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "dompurify": "3.4.17",
    "vite": "8.3.5",
    "valibot": "1.5.0",
    "prismjs": "1.30.0",
    "trim": "0.0.3",
    "katex": "0.18.10",
    "glob": "14.0.3",
    "minimatch": "11.0.4",
    "zod": "4.6.7",
    "uuid": "14.0.3"
  }
}
