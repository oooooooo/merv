{
  "name": "merv-cli",
  "version": "0.1.0",
  "description": "Markdown to PDF, using Mermaid.js and Vivliostyle CLI.",
  "type": "module",
  "bin": {
    "merv": "./merv.js"
  },
  "files": [
    "merv.js"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oooooooo/merv-cli.git"
  },
  "bugs": {
    "url": "https://github.com/oooooooo/merv-cli/issues"
  },
  "homepage": "https://github.com/oooooooo/merv-cli#readme",
  "author": "oooooooo",
  "dependencies": {
    "@mermaid-js/mermaid-cli": "11.16.0",
    "@vivliostyle/cli": "11.1.0"
  },
  "license": "MIT",
  "keywords": [
    "mermaid",
    "vivliostyle",
    "markdown",
    "pdf",
    "cli"
  ],
  "allowScripts": {
    "puppeteer@25.4.0": true,
    "fsevents@2.3.3": true
  }
}
